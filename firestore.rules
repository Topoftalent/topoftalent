rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is admin
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ── USERS ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
                    && !('isMember' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── VOTES ────────────────────────────────────────────────────
    match /votes/{artistId}/fans/{userId} {
      allow read:   if true;
      allow write:  if request.auth != null && request.auth.uid == userId
                    && request.resource.data.lastVote == request.time;
      allow delete: if isAdmin();
    }

    // ── COMMENTS ─────────────────────────────────────────────────
    match /comments/{artistId}/list/{commentId} {
      allow read:   if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.text.size() <= 200;
      allow delete: if isAdmin();
    }

    // ── ARTISTAS (future) ────────────────────────────────────────
    // Public read. Admins may edit ONLY the score fields (editorial /
    // criticos) from the admin panel; everything else stays Console-only.
    match /artistas/{artistId} {
      allow read: if true;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['score_tot', 'score_criticos']);
      allow create, delete: if false;
    }

    // ── OTROS TALENTOS ───────────────────────────────────────────
    // Public read — managed exclusively via Firebase Console (CRM)
    match /otros_talentos/{talentId} {
      allow read: if true;
      allow write: if false;
    }

    // ── COMENTARIOS EDITORIALES ──────────────────────────────────
    // Public read — managed exclusively via script o Firebase Console
    match /editorial_comments/{commentId} {
      allow read: if true;
      allow write: if false;
    }

    // ── EVENTOS ──────────────────────────────────────────────────
    match /eventos/{eventoId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
